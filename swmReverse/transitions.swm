#
# Transitions for scripted camera moves
#

screen crossFadeStandard
   texture cameraSnapshot
   length 2
   strength 1 0 
end

screen crossFadeShort
   texture cameraSnapshot
   length 1
   strength 1 0
end

screen crossFadeLong
   texture cameraSnapshot
   length 4
   strength 1 0
end

screen letterbox
   mode blend
   length 0
   strength 1
   texture letterbox2
end

screen cameraFlash
   mode additive
   length .7
   strength 1 .2 0
   colour (1, 1, 1) (1, 1, 1)
end

effect cameraFlash
   screen cameraFlash
end


effect crossFadeSnapStandard
   camera -snapshot
   screen crossFadeStandard
end

effect crossFadeSnapShort
   camera -snapshot
   screen crossFadeShort
end

effect crossFadeSnapLong
   camera -snapshot
   screen crossFadeLong
end

effect letterbox
   screen letterbox
end

particles letterbox_fade_in  
   inject 1 -hold .7
   life 3
   alpha 1 1 1 .5 .2 0
   size 1 1 1 1.2 1.5 1.8 2
   aspect 2
   source -offset (0, 1.07, 0)
   texture letterbox2 -sortOffset 1 -noFog -light -draw decalIgnoreDepth 
end

effect letterbox_fade_in   -rigid -cameraAttached
  particles letterbox_fade_in 
end
export letterbox_fade_in

particles letterbox_fade_in_UFO
   inject 1 -hold .7
   life 3
   alpha 1 1 1 .5 .2 0
   size 2 2 2 2.4 3 3.6 4 
   aspect 2
   source -offset (0, 2.07, 0)
   texture letterbox2 -sortOffset 1 -noFog -light -draw decalIgnoreDepth 
end

effect letterbox_fade_in_UFO   -rigid -cameraAttached
  particles letterbox_fade_in_UFO
end

export letterbox_fade_in_UFO

