   # source -offset (0, 1.07, 2)
   # texture letterbox2 -sortOffset 1 -noFog -light -draw decalIgnoreDepth 
# end





# Spore

screen crossFadeGalaxy
   texture cameraSnapshot
   length 2
   strength 1 0 
end

# Commenting out for demos -- we do it manually there.
effect crossFadeGalaxy
   camera -snapshot
   screen crossFadeGalaxy
end


effect crossFadeSnapshot
   camera -snapshot
end

screen showSnapshot
   texture cameraSnapshot
   length 1 -sustain 
   strength 1
end

effect showSnapshot
   screen showSnapshot
end

effect crossFadeFromSnapshot
   screen crossFadeGalaxy
end

screen fadeInFromBlack
   mode blend
   color (0, 0, 0)
   length 2
   strength 1 0
end

effect fadeInFromBlack
   screen fadeInFromBlack
end

screen screenBlack
   mode blend
   color (0, 0, 0)
   length 2 -sustain
end

effect screenBlack
   screen screenBlack
end

metaparticles black_screen_fade_in_black
   inject 1 -hold .1
   life .2
   effect screenBlack
end

metaparticles black_screen_fade_in_fade
   inject 1 -hold .5
   life 2
   effect fadeInFromBlack
end

effect black_screen_fade_in   -rigid -cameraAttached
  particleSequence
      metaparticles black_screen_fade_in_black
       metaparticles black_screen_fade_in_fade
  end
end
export black_screen_fade_in

# Experimental

screen exptAfterImage
   mode additive
   texture viewTarget
   length 0.25
   strength 0 0 0 1 1 0 0 0
   colour (0.3, 0.6, 1)
end

effect exptAfterImage
   camera -snapshot
   screen exptAfterImage
end

sequence exptAfterImages -loop
   play exptAfterImage
end

effect exptAfterImages
   sequence exptAfterImages
end










timeline realTime
   screen crossFadeStandardRealTime
      texture cameraSnapshot
      length 4
      strength 1 0
   end

   effect crossFadeSnapStandardRealTime
      camera -snapshot
      screen crossFadeStandardRealTime
   end
end
